# Copiar como .env y ajustar
# DEBUG_MODE=true registra en %APPDATA%\SpecRel\perf.log los bloqueos de la interfaz (>0,4 s) con su causa
DEBUG_MODE=false
# Ruta opcional a un catálogo MasterFormat (SQLite/CSV/XLSX) para autocompletado inicial
DEFAULT_CATALOG_PATH=
RECENT_FILES_MAX=10
# Forzar OpenGL por software si la vista 3D falla (RDP, drivers antiguos)
OPENGL_SOFTWARE=false
